# Copy this file to .env and fill it in. All settings live here.

# ---------- Web panel ----------
HOST=0.0.0.0
PORT=7319
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-long-password
# Long random text that keeps you signed in across restarts.
# Generate one:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# true when the panel is served over HTTPS (behind Nginx/Caddy)
SECURE_COOKIES=false

# ---------- Money ----------
DEFAULT_CURRENCY=AZN
TIMEZONE=Asia/Baku

# ---------- Google Sheet (Apps Script) ----------
# Web app URL from Apps Script → Deploy. Must end with /exec
APPS_SCRIPT_URL=https://script.google.com/macros/s/XXXXXXXXXXXXXXXXXXXXXXXX/exec
# Same text as SECRET in apps_script/Code.gs
APPS_SCRIPT_SECRET=put-the-same-long-random-text-here
# Seconds to keep sheet data in memory (edits made directly in the sheet appear after this, or press reload)
CACHE_TTL_SECONDS=60

# ---------- Telegram ----------
# From @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Comma-separated Telegram user IDs allowed to add costs. Send /start to the bot to see yours.
ALLOWED_TELEGRAM_IDS=
# Create a category automatically when you type an unknown one (/kitab 15)
AUTO_CREATE_CATEGORIES=true
